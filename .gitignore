# Dependencies (reinstall with: npm install)
node_modules/

# Build output (recreate with: npm run build)
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Environment files and secrets: never commit these
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
